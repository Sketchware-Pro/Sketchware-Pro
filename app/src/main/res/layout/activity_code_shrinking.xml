<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical" />

    <ScrollView
        android:id="@+id/content_scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingBottom="24dp">

            <!-- Protection -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="8dp"
                android:text="@string/code_shrinking_section_protection"
                android:textAppearance="?attr/textAppearanceTitleSmall"
                android:textColor="?attr/colorPrimary" />

            <com.google.android.material.listitem.ListItemLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="3dp">

                <com.google.android.material.listitem.ListItemCardView
                    style="?attr/listItemCardViewSegmentedStyle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardElevation="0dp"
                    app:shapeAppearance="@style/ShapeAppearance.CodeShrinking.Single"
                    app:cardBackgroundColor="?attr/colorSurfaceContainer"
                    app:cardForegroundColor="@android:color/transparent">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:minHeight="52dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/code_shrinking_mode_title"
                            android:textAppearance="?attr/textAppearanceBodyLargeEmphasized" />

                        <com.google.android.material.button.MaterialButtonToggleGroup
                            android:id="@+id/shrinker_group"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            app:selectionRequired="true"
                            app:singleSelection="true">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btn_disabled"
                                style="@style/Widget.Material3.Button.OutlinedButton"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/code_shrinking_disabled" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btn_proguard"
                                style="@style/Widget.Material3.Button.OutlinedButton"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/code_shrinking_proguard" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btn_r8"
                                style="@style/Widget.Material3.Button.OutlinedButton"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/code_shrinking_r8" />
                        </com.google.android.material.button.MaterialButtonToggleGroup>

                        <TextView
                            android:id="@+id/mode_hint"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:layout_marginBottom="4dp"
                            android:text="@string/code_shrinking_mode_hint_disabled"
                            android:textAppearance="?attr/textAppearanceBodyMedium"
                            android:textColor="?attr/colorOnSurfaceVariant" />
                    </LinearLayout>
                </com.google.android.material.listitem.ListItemCardView>
            </com.google.android.material.listitem.ListItemLayout>


            <LinearLayout
                android:id="@+id/options_section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_marginTop="19dp"
                    android:text="@string/code_shrinking_section_options"
                    android:textAppearance="?attr/textAppearanceTitleSmall"
                    android:textColor="?attr/colorPrimary" />

                <com.google.android.material.listitem.ListItemLayout
                    android:id="@+id/shrink_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="3dp"
                    android:clickable="true"
                    android:focusable="true">

                    <com.google.android.material.listitem.ListItemCardView
                        style="?attr/listItemCardViewSegmentedStyle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:cardElevation="0dp"
                        app:shapeAppearance="@style/ShapeAppearance.CodeShrinking.First"
                        app:cardBackgroundColor="?attr/colorSurfaceContainer"
                        app:cardForegroundColor="@android:color/transparent">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:minHeight="52dp"
                                android:orientation="horizontal">

                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginEnd="12dp"
                                    android:layout_weight="1"
                                    android:orientation="vertical">

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="@string/code_shrinking_shrink"
                                        android:textAppearance="?attr/textAppearanceBodyLargeEmphasized" />

                                    <TextView
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="2dp"
                                        android:text="@string/code_shrinking_shrink_hint"
                                        android:textAppearance="?attr/textAppearanceBodyMedium"
                                        android:textColor="?attr/colorOnSurfaceVariant" />
                                </LinearLayout>

                                <com.google.android.material.materialswitch.MaterialSwitch
                                    android:id="@+id/shrink_switch"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:contentDescription="@string/code_shrinking_shrink"
                                    app:thumbIcon="@drawable/ic_switch_thumb_state"
                                    app:thumbIconSize="18dp" />
                            </LinearLayout>

                            <LinearLayout
                                android:id="@+id/rules_panel"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:visibility="gone">

                                <com.google.android.material.listitem.ListItemLayout
                                    android:id="@+id/full_mode_row"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:clickable="true"
                                    android:focusable="true"
                                    android:layout_marginTop="3dp">

                                    <com.google.android.material.listitem.ListItemCardView
                                        style="?attr/listItemCardViewSegmentedStyle"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        app:cardElevation="0dp"
                                        app:shapeAppearance="@style/ShapeAppearance.CodeShrinking.Middle"
                                        app:cardBackgroundColor="?attr/colorSurfaceContainer"
                                        app:cardForegroundColor="@android:color/transparent">

                                        <LinearLayout
                                            android:layout_width="match_parent"
                                            android:layout_height="wrap_content"
                                            android:gravity="center_vertical"
                                            android:minHeight="52dp"
                                            android:orientation="horizontal">

                                            <LinearLayout
                                                android:layout_width="0dp"
                                                android:layout_height="wrap_content"
                                                android:layout_marginEnd="12dp"
                                                android:layout_weight="1"
                                                android:orientation="vertical">

                                                <TextView
                                                    android:id="@+id/full_mode_title"
                                                    android:layout_width="wrap_content"
                                                    android:layout_height="wrap_content"
                                                    android:text="@string/common_word_full_mode"
                                                    android:textAppearance="?attr/textAppearanceBodyLargeEmphasized" />

                                                <TextView
                                                    android:layout_width="match_parent"
                                                    android:layout_height="wrap_content"
                                                    android:layout_marginTop="2dp"
                                                    android:text="@string/code_shrinker_full_mode_def"
                                                    android:textAppearance="?attr/textAppearanceBodyMedium"
                                                    android:textColor="?attr/colorOnSurfaceVariant" />

                                                <TextView
                                                    android:layout_width="match_parent"
                                                    android:layout_height="wrap_content"
                                                    android:layout_marginTop="6dp"
                                                    android:text="@string/code_shrinking_full_mode_note"
                                                    android:textAppearance="?attr/textAppearanceBodySmall"
                                                    android:textColor="?attr/colorError" />
                                            </LinearLayout>

                                            <ImageView
                                                android:layout_width="24dp"
                                                android:layout_height="24dp"
                                                android:importantForAccessibility="no"
                                                android:src="@drawable/ic_library_books_24"
                                                app:tint="?attr/colorPrimary" />
                                        </LinearLayout>
                                    </com.google.android.material.listitem.ListItemCardView>
                                </com.google.android.material.listitem.ListItemLayout>
                            </LinearLayout>
                        </LinearLayout>
                    </com.google.android.material.listitem.ListItemCardView>
                </com.google.android.material.listitem.ListItemLayout>

                <com.google.android.material.listitem.ListItemLayout
                    android:id="@+id/rules_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="3dp"
                    android:clickable="true"
                    android:focusable="true">

                    <com.google.android.material.listitem.ListItemCardView
                        style="?attr/listItemCardViewSegmentedStyle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:cardElevation="0dp"
                        app:shapeAppearance="@style/ShapeAppearance.CodeShrinking.Middle"
                        app:cardBackgroundColor="?attr/colorSurfaceContainer"
                        app:cardForegroundColor="@android:color/transparent">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:minHeight="52dp"
                            android:orientation="horizontal">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginEnd="12dp"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/code_shrinking_rules"
                                    android:textAppearance="?attr/textAppearanceBodyLargeEmphasized" />

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:text="@string/code_shrinking_rules_hint"
                                    android:textAppearance="?attr/textAppearanceBodyMedium"
                                    android:textColor="?attr/colorOnSurfaceVariant" />

                                <TextView
                                    android:id="@+id/rules_warning"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="4dp"
                                    android:text="@string/code_shrinking_rules_conflict"
                                    android:textAppearance="?attr/textAppearanceBodyMedium"
                                    android:textColor="?attr/colorError"
                                    android:visibility="gone" />
                            </LinearLayout>

                            <ImageView
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:importantForAccessibility="no"
                                android:src="@drawable/ic_edit_white_48dp"
                                app:tint="?attr/colorPrimary" />
                        </LinearLayout>
                    </com.google.android.material.listitem.ListItemCardView>
                </com.google.android.material.listitem.ListItemLayout>

                <com.google.android.material.listitem.ListItemLayout
                    android:id="@+id/obfuscate_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="3dp"
                    android:clickable="true"
                    android:focusable="true">

                    <com.google.android.material.listitem.ListItemCardView
                        style="?attr/listItemCardViewSegmentedStyle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:cardElevation="0dp"
                        app:shapeAppearance="@style/ShapeAppearance.CodeShrinking.Middle"
                        app:cardBackgroundColor="?attr/colorSurfaceContainer"
                        app:cardForegroundColor="@android:color/transparent">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                            android:minHeight="52dp"
                            android:orientation="horizontal">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginEnd="12dp"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/code_shrinking_obfuscate"
                                    android:textAppearance="?attr/textAppearanceBodyLargeEmphasized" />

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:text="@string/code_shrinking_obfuscate_hint"
                                    android:textAppearance="?attr/textAppearanceBodyMedium"
                                    android:textColor="?attr/colorOnSurfaceVariant" />
                            </LinearLayout>

                            <com.google.android.material.materialswitch.MaterialSwitch
                                android:id="@+id/obfuscate_switch"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:contentDescription="@string/code_shrinking_obfuscate"
                                app:thumbIcon="@drawable/ic_switch_thumb_state"
                                app:thumbIconSize="18dp" />
                        </LinearLayout>
                    </com.google.android.material.listitem.ListItemCardView>
                </com.google.android.material.listitem.ListItemLayout>

                <com.google.android.material.listitem.ListItemLayout
                    android:id="@+id/optimize_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="3dp"
                    android:clickable="true"
                    android:focusable="true">

                    <com.google.android.material.listitem.ListItemCardView
                        style="?attr/listItemCardViewSegmentedStyle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:cardElevation="0dp"
                        app:shapeAppearance="@style/ShapeAppearance.CodeShrinking.Last"
                        app:cardBackgroundColor="?attr/colorSurfaceContainer"
                        app:cardForegroundColor="@android:color/transparent">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                            android:minHeight="52dp"
                            android:orientation="horizontal">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginEnd="12dp"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/code_shrinking_optimize"
                                    android:textAppearance="?attr/textAppearanceBodyLargeEmphasized" />

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:text="@string/code_shrinking_optimize_hint"
                                    android:textAppearance="?attr/textAppearanceBodyMedium"
                                    android:textColor="?attr/colorOnSurfaceVariant" />
                            </LinearLayout>

                            <com.google.android.material.materialswitch.MaterialSwitch
                                android:id="@+id/optimize_switch"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:contentDescription="@string/code_shrinking_optimize"
                                app:thumbIcon="@drawable/ic_switch_thumb_state"
                                app:thumbIconSize="18dp" />
                        </LinearLayout>
                    </com.google.android.material.listitem.ListItemCardView>
                </com.google.android.material.listitem.ListItemLayout>



            </LinearLayout>


            <!-- Extra obfuscation -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="19dp"
                android:text="@string/code_shrinking_section_obfuscation"
                android:textAppearance="?attr/textAppearanceTitleSmall"
                android:textColor="?attr/colorPrimary" />

            <com.google.android.material.listitem.ListItemLayout
                android:id="@+id/stringfog_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="3dp"
                android:clickable="true"
                android:focusable="true">

                <com.google.android.material.listitem.ListItemCardView
                    style="?attr/listItemCardViewSegmentedStyle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardElevation="0dp"
                    app:shapeAppearance="@style/ShapeAppearance.CodeShrinking.Single"
                    app:cardBackgroundColor="?attr/colorSurfaceContainer"
                    app:cardForegroundColor="@android:color/transparent">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:minHeight="52dp"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="12dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/code_shrinking_enable_stringfog"
                                android:textAppearance="?attr/textAppearanceBodyLargeEmphasized" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="@string/code_shrinking_stringfog_hint"
                                android:textAppearance="?attr/textAppearanceBodyMedium"
                                android:textColor="?attr/colorOnSurfaceVariant" />
                        </LinearLayout>

                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/stringfog_switch"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:contentDescription="@string/code_shrinking_enable_stringfog"
                            app:thumbIcon="@drawable/ic_switch_thumb_state"
                            app:thumbIconSize="18dp" />
                    </LinearLayout>
                </com.google.android.material.listitem.ListItemCardView>
            </com.google.android.material.listitem.ListItemLayout>

            <!-- Debugging -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="19dp"
                android:text="@string/code_shrinking_section_debug"
                android:textAppearance="?attr/textAppearanceTitleSmall"
                android:textColor="?attr/colorPrimary" />

            <com.google.android.material.listitem.ListItemLayout
                android:id="@+id/debug_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:clickable="true"
                android:focusable="true">

                <com.google.android.material.listitem.ListItemCardView
                    style="?attr/listItemCardViewSegmentedStyle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardElevation="0dp"
                    app:shapeAppearance="@style/ShapeAppearance.CodeShrinking.Single"
                    app:cardBackgroundColor="?attr/colorSurfaceContainer"
                    app:cardForegroundColor="@android:color/transparent">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:minHeight="52dp"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="12dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/code_shrinking_debug"
                                android:textAppearance="?attr/textAppearanceBodyLargeEmphasized" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="@string/code_shrinking_debug_hint"
                                android:textAppearance="?attr/textAppearanceBodyMedium"
                                android:textColor="?attr/colorOnSurfaceVariant" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:text="@string/code_shrinking_debug_note"
                                android:textAppearance="?attr/textAppearanceBodySmall"
                                android:textColor="?attr/colorError" />
                        </LinearLayout>

                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/debug_switch"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:contentDescription="@string/code_shrinking_debug"
                            app:thumbIcon="@drawable/ic_switch_thumb_state"
                            app:thumbIconSize="18dp" />
                    </LinearLayout>
                </com.google.android.material.listitem.ListItemCardView>
            </com.google.android.material.listitem.ListItemLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
