<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

<RelativeLayout
    android:id="@+id/layout"
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_weight="1">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            style="@style/Widget.SketchwarePro.Toolbar.SmallText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:navigationIcon="?attr/homeAsUpIndicator"
            app:subtitle="@string/common_word_oncreate"
            app:title="@string/common_word_activity" />

        <com.besome.sketch.editor.view.ViewLogicEditor
            android:id="@+id/editor"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_margin="4dp"
            android:background="?attr/colorSurfaceContainerLow"
            android:forceDarkAllowed="false"
            tools:ignore="UnusedAttribute" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/canvas_controls"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:layout_alignParentEnd="true"
        android:layout_marginTop="?attr/actionBarSize"
        android:layout_marginEnd="12dp"
        android:alpha="0.92"
        android:background="@drawable/canvas_control_bg"
        android:elevation="3dp"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/btn_zoom_out"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:contentDescription="@string/logic_zoom_out"
            android:src="@drawable/ic_zoom_out_canvas"
            android:tint="?attr/colorOnSurface" />

        <TextView
            android:id="@+id/tv_zoom"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center"
            android:minWidth="44dp"
            android:text="100%"
            android:textColor="?attr/colorOnSurface"
            android:textSize="12sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/btn_zoom_in"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:contentDescription="@string/logic_zoom_in"
            android:src="@drawable/ic_zoom_in_canvas"
            android:tint="?attr/colorOnSurface" />

        <Button
            android:id="@+id/btn_canvas_center"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:minWidth="64dp"
            android:text="@string/logic_canvas_center"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btn_canvas_fit"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:minWidth="64dp"
            android:text="@string/logic_canvas_fit"
            android:textSize="12sp" />
    </LinearLayout>

    <com.besome.sketch.editor.LogicEditorDrawer
        android:id="@+id/right_drawer"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_alignParentTop="true"
        android:layout_alignParentEnd="true"
        android:translationX="200dp" />

    <LinearLayout
        android:id="@+id/layout_palette"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fab_toggle_palette"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/action_button_margin"
            android:alpha="0.85"
            android:src="@drawable/block_flled_white"
            app:backgroundTint="?attr/colorSecondaryContainer"
            app:elevation="2dp"
            app:fabSize="mini"
            app:pressedTranslationZ="4dp"
            app:tint="?attr/colorOnSecondaryContainer"
            tools:ignore="ContentDescription" />

        <LinearLayout
            android:id="@+id/area_palette"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:elevation="16dp"
            android:orientation="horizontal">

            <com.besome.sketch.editor.logic.PaletteBlock
                android:id="@+id/palette_block"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
        </LinearLayout>
    </LinearLayout>

    <com.besome.sketch.editor.logic.LogicTopMenu
        android:id="@+id/top_menu"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentStart="true"
        android:layout_alignParentTop="true"
        android:translationY="-48dp" />

    <com.besome.sketch.editor.view.ViewDummy
        android:id="@+id/dummy"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />
</RelativeLayout>

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:labelVisibilityMode="labeled"
        app:menu="@menu/logic_bottom_nav" />
</LinearLayout>
