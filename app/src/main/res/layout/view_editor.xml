<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/layout_palette"
        android:layout_width="88dp"
        android:layout_height="match_parent"
        android:background="?attr/colorSurface"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/palette_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />

        <EditText
            android:id="@+id/search_widgets"
            android:layout_width="match_parent"
            android:layout_height="32dp"
            android:layout_marginHorizontal="4dp"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="4dp"
            android:background="@drawable/palette_search_bg"
            android:drawableStart="@drawable/ic_search_palette"
            android:drawablePadding="6dp"
            android:hint="@string/view_search_widgets"
            android:imeOptions="actionSearch"
            android:importantForAutofill="no"
            android:inputType="text"
            android:maxLines="1"
            android:paddingHorizontal="10dp"
            android:singleLine="true"
            android:textSize="12sp" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <com.besome.sketch.editor.view.palette.PaletteWidget
                android:id="@+id/palette_widget"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <com.besome.sketch.editor.view.palette.PaletteFavorite
                android:id="@+id/palette_favorite"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone" />
        </FrameLayout>
    </LinearLayout>

    <com.besome.sketch.editor.view.DotGridFrameLayout
        android:id="@+id/shape"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_toEndOf="@+id/layout_palette"
        android:background="?attr/colorSurfaceContainer"
        android:forceDarkAllowed="false"
        tools:ignore="UnusedAttribute" />


    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_toggle_palette"
        style="@style/Widget.Material3.Button.TonalButton"
        android:layout_width="wrap_content"
        android:layout_height="32dp"
        android:layout_alignParentTop="true"
        android:layout_marginStart="6dp"
        android:layout_marginTop="6dp"
        android:layout_toEndOf="@+id/layout_palette"
        android:alpha="0.9"
        android:contentDescription="@string/view_toggle_widgets"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:minWidth="0dp"
        android:paddingHorizontal="8dp"
        app:icon="@drawable/ic_mtrl_component"
        app:iconGravity="textStart"
        app:iconPadding="0dp"
        app:iconSize="16dp"
        app:iconTint="@color/event_accent" />

    <LinearLayout
        android:id="@+id/view_canvas_controls"
        android:layout_width="wrap_content"
        android:layout_height="30dp"
        android:layout_alignParentTop="true"
        android:layout_alignParentEnd="true"
        android:layout_marginTop="6dp"
        android:layout_marginEnd="8dp"
        android:alpha="0.88"
        android:background="@drawable/canvas_control_bg"
        android:elevation="2dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="2dp">

        <ImageButton
            android:id="@+id/btn_vzoom_out"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/logic_zoom_out"
            android:padding="7dp"
            android:src="@drawable/ic_zoom_out_canvas"
            app:tint="?attr/colorOnSurface" />

        <TextView
            android:id="@+id/tv_vzoom"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center"
            android:minWidth="36dp"
            android:text="100%"
            android:textColor="?attr/colorOnSurface"
            android:textSize="11sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/btn_vzoom_in"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/logic_zoom_in"
            android:padding="7dp"
            android:src="@drawable/ic_zoom_in_canvas"
            app:tint="?attr/colorOnSurface" />

        <Button
            android:id="@+id/btn_vfit"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minWidth="0dp"
            android:paddingHorizontal="8dp"
            android:text="@string/logic_canvas_fit"
            android:textColor="@color/event_accent"
            android:textSize="11sp" />

        <ImageButton
            android:id="@+id/btn_focus_preview"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/view_focus_preview"
            android:padding="7dp"
            android:src="@drawable/ic_focus_preview"
            app:tint="@color/event_accent" />
    </LinearLayout>

    <com.besome.sketch.editor.view.ViewDummy
        android:id="@+id/dummy"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />


    <com.besome.sketch.editor.view.ViewProperties
        android:id="@+id/properties"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:layout_marginLeft="16dp"
        android:layout_marginRight="16dp"
        android:translationY="150dp" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/delete_view"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:layout_marginBottom="20dp"
        android:animateLayoutChanges="true"
        android:gravity="center"
        android:orientation="horizontal"
        android:translationY="106dp"
        app:cardBackgroundColor="?colorSurfaceContainerHighest"
        app:cardCornerRadius="18dp"
        app:strokeWidth="1dp"
        tools:translationY="-20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="20dp"
            android:gravity="center">

            <ImageView
                android:id="@+id/icon_delete"
                android:layout_width="30dp"
                android:layout_height="50dp"
                android:contentDescription="@null"
                android:padding="2dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_mtrl_delete"
                app:tint="?colorOnSurfaceVariant" />

            <TextView
                android:id="@+id/text_delete"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:text="Drag here to delete"
                android:textColor="?colorOnSurfaceVariant" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

</RelativeLayout>
