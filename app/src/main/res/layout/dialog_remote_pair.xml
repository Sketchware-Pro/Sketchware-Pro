<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clipToPadding="false">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">
    <TextView
        android:id="@+id/pair_device"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:textAppearance="?attr/textAppearanceTitleMedium"
        android:textColor="?attr/colorOnSurface" />
    <TextView
        android:id="@+id/pair_help"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/remote_debug_pair_help"
        android:textAppearance="?attr/textAppearanceBodyMedium"
        android:textColor="?attr/colorOnSurfaceVariant" />
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/pair_port_layout"
        style="?attr/textInputOutlinedStyle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:hint="@string/remote_debug_pair_port">
        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/pair_port"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:importantForAutofill="no"
            android:inputType="number"
            android:maxLength="5" />
    </com.google.android.material.textfield.TextInputLayout>
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/pair_code_layout"
        style="?attr/textInputOutlinedStyle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:hint="@string/remote_debug_pair_code"
        app:expandedHintEnabled="false">
        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/pair_code"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:importantForAutofill="no"
            android:inputType="number"
            android:gravity="center"
            android:letterSpacing="0.25"
            android:textSize="24sp"
            android:imeOptions="actionDone"
            android:maxLength="6"
            android:saveEnabled="false" />
    </com.google.android.material.textfield.TextInputLayout>
</LinearLayout>
</ScrollView>
